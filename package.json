{
  "name": "companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @companion/web dev",
    "lint": "eslint . && pnpm --filter @companion/web lint",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/daemon --noEmit && tsc -p packages/shared --noEmit && pnpm --filter @companion/web typecheck",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "pnpm --filter @companion/web smoke",
    "acp-hello": "pnpm --filter @companion/daemon acp-hello"
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
